# ==============================================================================
# YAMASSI — VARIABLES DE ENTORNO EN PRODUCCIÓN (npm run build / preview)
# ==============================================================================
# Vite y Astro cargan automáticamente este archivo al ejecutar `npm run build`.

# Identificador de entorno
PUBLIC_ENV=production

# URL del sitio web oficial en producción
PUBLIC_SITE_URL=https://yamassi.com

# URLs oficiales de producción de las aplicaciones del ecosistema Yamassi
PUBLIC_TIENDA_URL=https://tienda.yamassi.com/
PUBLIC_RESTOBAR_URL=https://restobar.yamassi.com/
PUBLIC_CITAS_URL=https://citas.yamassi.com/
PUBLIC_API_URL=https://api.yamassi.com/api

# Configuración institucional oficial
PUBLIC_SITE_NAME=Yamassi
PUBLIC_SUPPORT_EMAIL=soporte@yamassi.com
PUBLIC_WHATSAPP_NUMBER=+51900000000

# Debug y analíticas en producción
PUBLIC_ENABLE_ANALYTICS=true
PUBLIC_DEBUG_LOGS=false
