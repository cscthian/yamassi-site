# ==============================================================================
# YAMASSI — VARIABLES DE ENTORNO BASE / COMPARTIDAS
# ==============================================================================
# Este archivo contiene valores por defecto para el proyecto.
# Son sobreescritos automáticamente por:
# - .env.development durante `npm run dev`
# - .env.production durante `npm run build` / `npm run preview`
# - .env.local para anulaciones locales privadas en tu máquina

# Entorno activo
PUBLIC_ENV=development

# URLs Base del Ecosistema Yamassi
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_TIENDA_URL=http://localhost:3000/
PUBLIC_RESTOBAR_URL=http://localhost:3002/
PUBLIC_CITAS_URL=http://localhost:3003/
PUBLIC_API_URL=http://localhost:8000/api

# Configuración institucional
PUBLIC_SITE_NAME=Yamassi
PUBLIC_SUPPORT_EMAIL=soporte@yamassi.com
PUBLIC_WHATSAPP_NUMBER=+51999999999

# Flags de depuración y características
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_DEBUG_LOGS=true
