---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<section class={`relative overflow-hidden bg-gradient-to-b from-[#0b1f4d] via-[#0e2a5c] to-[#080c14] text-white pt-32 pb-20 md:pt-40 md:pb-28 ${className}`}>
  <!-- Glow background elements -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[500px] rounded-full bg-sky-500/20 blur-[120px]" aria-hidden="true" />
  <div class="pointer-events-none absolute top-1/3 -right-20 w-[450px] h-[450px] rounded-full bg-blue-500/15 blur-[100px]" aria-hidden="true" />
  <div class="pointer-events-none absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-emerald-500/15 blur-[100px]" aria-hidden="true" />

  <div class="container relative mx-auto px-4">
    <!-- Breadcrumb / pill -->
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-4 py-1.5 text-xs md:text-sm font-semibold text-sky-300 backdrop-blur-md shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-sky-400 animate-ping"></span>
        <span>Yamassi para Clínicas y Consultorios Odontológicos</span>
        <span class="rounded-full bg-sky-400/20 px-2 py-0.5 text-[10px] uppercase font-bold text-sky-200">Salud Dental 360°</span>
      </div>
    </div>

    <!-- Main Title -->
    <div class="mt-8 mx-auto max-w-4xl text-center">
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-balance leading-[1.12]">
        Control clínico y administrativo completo <span class="bg-gradient-to-r from-sky-300 via-blue-200 to-emerald-300 bg-clip-text text-transparent">para tu consultorio dental</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-white/80 leading-relaxed max-w-2xl mx-auto text-balance">
        Odontograma interactivo digital, historias clínicas seguras, presupuestos claros por fases, confirmaciones automáticas por WhatsApp y liquidación exacta de honorarios a especialistas.
      </p>

      <!-- CTAs -->
      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/login"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-sky-500 via-blue-600 to-emerald-500 px-8 py-4 text-base font-bold text-white shadow-[0_12px_32px_rgba(14,165,233,0.35)] transition-all hover:scale-105 hover:shadow-[0_16px_40px_rgba(14,165,233,0.45)] cursor-pointer"
        >
          <span>Empezar con Yamassi gratis</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="#odontograma"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-4 text-base font-semibold text-white/90 backdrop-blur-md transition-all hover:bg-white/10 hover:text-white"
        >
          <span>Conocer el odontograma digital</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs sm:text-sm text-white/60">
        ✓ Conforme a norma técnica MINSA &nbsp;·&nbsp; ✓ Cero ausentismo de pacientes con WhatsApp &nbsp;·&nbsp; ✓ Soporte local
      </p>
    </div>

    <!-- Quick stats strip -->
    <div class="mt-14 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-sky-300">Norma MINSA</div>
        <div class="mt-1 text-xs text-white/70">Odontograma estandarizado</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-emerald-300">-70%</div>
        <div class="mt-1 text-xs text-white/70">Menos faltas con WhatsApp</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-blue-300">100% Digital</div>
        <div class="mt-1 text-xs text-white/70">Historias y radiografías en nube</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-white">Comisiones</div>
        <div class="mt-1 text-xs text-white/70">Cálculo exacto a doctores</div>
      </div>
    </div>

    <!-- Mockup Preview Card: Odontograma & Expediente Clínico -->
    <div class="mt-14 max-w-5xl mx-auto rounded-3xl border border-white/15 bg-slate-900/80 p-3 sm:p-5 shadow-[0_30px_90px_rgba(0,0,0,0.6)] backdrop-blur-xl">
      <div class="flex items-center justify-between pb-3 px-2 border-b border-white/10 text-xs text-white/60">
        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 font-mono text-white/75">Expediente Odontológico — Paciente: Sofía Mendoza (HC #0412)</span>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-sky-400 font-medium">
          <span class="h-2 w-2 rounded-full bg-sky-400"></span> Dr. Alejandro Vargas (Rehabilitación Oral)
        </span>
      </div>

      <div class="mt-4 grid grid-cols-1 lg:grid-cols-12 gap-4">
        <!-- Odontograma interactivo preview -->
        <div class="lg:col-span-8 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
          <div class="flex items-center justify-between text-xs pb-3 border-b border-white/10">
            <span class="font-bold text-sky-300">Odontograma Adulto (FDI) — Arcada Superior e Inferior</span>
            <div class="flex gap-2">
              <span class="flex items-center gap-1 text-[11px] text-rose-400"><span class="h-2 w-2 rounded-full bg-rose-500"></span> Caries (Rojo)</span>
              <span class="flex items-center gap-1 text-[11px] text-blue-400"><span class="h-2 w-2 rounded-full bg-blue-500"></span> Realizado (Azul)</span>
            </div>
          </div>

          <!-- Representación visual de piezas dentales -->
          <div class="mt-4 space-y-4">
            <!-- Arcada superior -->
            <div class="text-[11px] text-slate-400 text-center">Arcada Superior (18 al 28)</div>
            <div class="grid grid-cols-8 gap-1.5 text-center">
              <div class="rounded-lg border border-white/10 bg-white/5 p-1.5">
                <div class="font-mono font-bold text-xs text-white">18</div>
                <div class="text-[10px] text-slate-400">Ausente</div>
              </div>
              <div class="rounded-lg border border-rose-500/40 bg-rose-950/30 p-1.5">
                <div class="font-mono font-bold text-xs text-rose-300">16</div>
                <div class="text-[10px] text-rose-300">Caries O</div>
              </div>
              <div class="rounded-lg border border-blue-500/40 bg-blue-950/30 p-1.5">
                <div class="font-mono font-bold text-xs text-blue-300">14</div>
                <div class="text-[10px] text-blue-300">Resina OK</div>
              </div>
              <div class="rounded-lg border border-white/10 bg-white/5 p-1.5">
                <div class="font-mono font-bold text-xs text-white">11</div>
                <div class="text-[10px] text-emerald-400">Sano</div>
              </div>
              <div class="rounded-lg border border-white/10 bg-white/5 p-1.5">
                <div class="font-mono font-bold text-xs text-white">21</div>
                <div class="text-[10px] text-emerald-400">Sano</div>
              </div>
              <div class="rounded-lg border border-amber-500/40 bg-amber-950/30 p-1.5">
                <div class="font-mono font-bold text-xs text-amber-300">24</div>
                <div class="text-[10px] text-amber-300">Endodoncia</div>
              </div>
              <div class="rounded-lg border border-blue-500/40 bg-blue-950/30 p-1.5">
                <div class="font-mono font-bold text-xs text-blue-300">26</div>
                <div class="text-[10px] text-blue-300">Corona</div>
              </div>
              <div class="rounded-lg border border-white/10 bg-white/5 p-1.5">
                <div class="font-mono font-bold text-xs text-white">28</div>
                <div class="text-[10px] text-slate-400">Extracción</div>
              </div>
            </div>

            <!-- Evolución del plan de tratamiento -->
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs">
              <span class="text-slate-300">Plan de tratamiento activo: <strong>Rehabilitación Integral</strong></span>
              <span class="text-emerald-400 font-bold">Fase 2 de 3 en progreso</span>
            </div>
          </div>
        </div>

        <!-- Presupuesto y pagos de la paciente -->
        <div class="lg:col-span-4 rounded-2xl border border-sky-500/30 bg-sky-950/20 p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-sky-300 uppercase tracking-wider">Presupuesto #182</span>
              <span class="rounded bg-sky-500/20 text-sky-300 px-2 py-0.5 text-[10px] font-bold">Aprobado</span>
            </div>

            <div class="mt-3 space-y-2 text-xs">
              <div class="flex justify-between py-1 border-b border-white/5 text-slate-300">
                <span>1x Profilaxis y Destartraje</span>
                <span class="font-mono text-emerald-300">S/ 120.00</span>
              </div>
              <div class="flex justify-between py-1 border-b border-white/5 text-slate-300">
                <span>2x Resina Estética 3M</span>
                <span class="font-mono text-emerald-300">S/ 260.00</span>
              </div>
              <div class="flex justify-between py-1 border-b border-white/5 text-slate-300">
                <span>1x Corona Zirconio (Pza 26)</span>
                <span class="font-mono text-emerald-300">S/ 850.00</span>
              </div>
            </div>

            <div class="mt-3 pt-2 border-t border-white/10 text-xs">
              <div class="flex justify-between font-bold text-white">
                <span>Total Presupuestado:</span>
                <span class="font-mono text-sky-300">S/ 1,230.00</span>
              </div>
              <div class="flex justify-between text-slate-400 mt-1">
                <span>Abonado a la fecha:</span>
                <span class="font-mono text-emerald-400">S/ 650.00</span>
              </div>
              <div class="flex justify-between text-amber-300 font-bold mt-1">
                <span>Saldo pendiente:</span>
                <span class="font-mono">S/ 580.00</span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-white/10">
            <div class="rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 py-2.5 text-center text-xs font-bold text-white shadow">
              Registrar Cobro / Boleta Salud SUNAT
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
