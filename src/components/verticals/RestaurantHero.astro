---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<section class={`relative overflow-hidden bg-gradient-to-b from-[#0b1f4d] via-[#0d2763] to-[#080c14] text-white pt-32 pb-20 md:pt-40 md:pb-28 ${className}`}>
  <!-- Glow background elements -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[500px] rounded-full bg-emerald-500/15 blur-[120px]" aria-hidden="true" />
  <div class="pointer-events-none absolute top-1/3 -right-20 w-[450px] h-[450px] rounded-full bg-blue-500/15 blur-[100px]" aria-hidden="true" />
  <div class="pointer-events-none absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-amber-500/10 blur-[100px]" aria-hidden="true" />

  <div class="container relative mx-auto px-4">
    <!-- Breadcrumb / pill -->
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-500/10 px-4 py-1.5 text-xs md:text-sm font-semibold text-amber-300 backdrop-blur-md shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>Yamassi para Restaurantes, Bares y Cafeterías</span>
        <span class="rounded-full bg-amber-400/20 px-2 py-0.5 text-[10px] uppercase font-bold text-amber-200">Gourmet & Fast Food</span>
      </div>
    </div>

    <!-- Main Title -->
    <div class="mt-8 mx-auto max-w-4xl text-center">
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-balance leading-[1.12]">
        Control de caja y comandas <span class="bg-gradient-to-r from-amber-300 via-orange-300 to-emerald-300 bg-clip-text text-transparent">que no se cuelga en hora punta</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-white/80 leading-relaxed max-w-2xl mx-auto text-balance">
        Toma pedidos desde tablet o celular, envía comandas automáticas a cocina y barra, divide cuentas en segundos y factura con SUNAT sin errores ni demoras.
      </p>

      <!-- CTAs -->
      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/login"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 px-8 py-4 text-base font-bold text-white shadow-[0_12px_32px_rgba(16,185,129,0.35)] transition-all hover:scale-105 hover:shadow-[0_16px_40px_rgba(16,185,129,0.45)] cursor-pointer"
        >
          <span>Empezar con Yamassi gratis</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="#comandas"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-4 text-base font-semibold text-white/90 backdrop-blur-md transition-all hover:bg-white/10 hover:text-white"
        >
          <span>Ver cómo funcionan las comandas</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs sm:text-sm text-white/60">
        ✓ Sin tarjeta de crédito &nbsp;·&nbsp; ✓ Compatible con impresoras térmicas ESC/POS &nbsp;·&nbsp; ✓ Soporte en Perú
      </p>
    </div>

    <!-- Quick stats strip -->
    <div class="mt-14 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-emerald-300">0 seg</div>
        <div class="mt-1 text-xs text-white/70">Demora en envío a cocina</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-amber-300">100%</div>
        <div class="mt-1 text-xs text-white/70">Arqueos de caja cuadrados</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-sky-300">1 Clic</div>
        <div class="mt-1 text-xs text-white/70">División de cuentas comensal</div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-bold text-white">SUNAT</div>
        <div class="mt-1 text-xs text-white/70">Boletas y facturas al instante</div>
      </div>
    </div>

    <!-- Mockup Preview Card -->
    <div class="mt-14 max-w-5xl mx-auto rounded-3xl border border-white/15 bg-slate-900/80 p-3 sm:p-5 shadow-[0_30px_90px_rgba(0,0,0,0.6)] backdrop-blur-xl">
      <div class="flex items-center justify-between pb-3 px-2 border-b border-white/10 text-xs text-white/60">
        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 font-mono text-white/75">Panel Salón & Comandas — Turno Almuerzo</span>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-emerald-400 font-medium">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span> Conectado a cocina
        </span>
      </div>

      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- Mesa Card 1 -->
        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-4">
          <div class="flex items-center justify-between">
            <span class="font-bold text-emerald-300 text-sm">Mesa 04 (Salón Principal)</span>
            <span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-semibold text-emerald-300">Ocupada · 4p</span>
          </div>
          <p class="text-xs text-white/70 mt-2">Mozo: Renzo C. · 24 min</p>
          <div class="mt-3 space-y-1.5 border-t border-white/10 pt-2 text-xs">
            <div class="flex justify-between text-white/90">
              <span>1x Lomo Saltado Criollo</span>
              <span class="text-emerald-400 font-mono">Listo</span>
            </div>
            <div class="flex justify-between text-white/90">
              <span>1x Ceviche Mixto Especial</span>
              <span class="text-amber-400 font-mono">En cocina</span>
            </div>
            <div class="flex justify-between text-white/90">
              <span>2x Chicha Morada 1L</span>
              <span class="text-emerald-400 font-mono">Entregado</span>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-2 text-xs font-bold text-white">
            <span>Total actual:</span>
            <span class="text-emerald-300 font-mono text-sm">S/ 118.00</span>
          </div>
        </div>

        <!-- Mesa Card 2 -->
        <div class="rounded-2xl border border-amber-500/30 bg-amber-950/20 p-4">
          <div class="flex items-center justify-between">
            <span class="font-bold text-amber-300 text-sm">Mesa 08 (Terraza)</span>
            <span class="rounded-full bg-amber-500/20 px-2 py-0.5 text-[10px] font-semibold text-amber-300">Pidiendo Cuenta</span>
          </div>
          <p class="text-xs text-white/70 mt-2">Mozo: Andrea M. · 48 min</p>
          <div class="mt-3 space-y-1.5 border-t border-white/10 pt-2 text-xs">
            <div class="flex justify-between text-white/90">
              <span>2x Pollo a la Brasa 1/2</span>
              <span class="text-emerald-400 font-mono">Entregado</span>
            </div>
            <div class="flex justify-between text-white/90">
              <span>1x Porción Tequeños</span>
              <span class="text-emerald-400 font-mono">Entregado</span>
            </div>
            <div class="flex justify-between text-amber-300 font-semibold">
              <span>Cuenta dividida:</span>
              <span>2 personas</span>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-2 text-xs font-bold text-white">
            <span>Cobro: Yape + Tarjeta</span>
            <span class="text-amber-300 font-mono text-sm">S/ 74.50 c/u</span>
          </div>
        </div>

        <!-- Mesa Card 3 -->
        <div class="rounded-2xl border border-sky-500/30 bg-sky-950/20 p-4">
          <div class="flex items-center justify-between">
            <span class="font-bold text-sky-300 text-sm">Delivery / Llevar #102</span>
            <span class="rounded-full bg-sky-500/20 px-2 py-0.5 text-[10px] font-semibold text-sky-300">Motorizado Asignado</span>
          </div>
          <p class="text-xs text-white/70 mt-2">Cliente: Carlos Quispe · Av. Javier Prado</p>
          <div class="mt-3 space-y-1.5 border-t border-white/10 pt-2 text-xs">
            <div class="flex justify-between text-white/90">
              <span>1x Arroz con Mariscos</span>
              <span class="text-sky-300 font-mono">Empacado</span>
            </div>
            <div class="flex justify-between text-white/90">
              <span>1x Causa Rellena Cangrejo</span>
              <span class="text-sky-300 font-mono">Empacado</span>
            </div>
            <div class="flex justify-between text-emerald-400">
              <span>Boleta Electrónica:</span>
              <span class="font-mono">B001-00249</span>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-2 text-xs font-bold text-white">
            <span>Pagado por Plin:</span>
            <span class="text-sky-300 font-mono text-sm">S/ 86.00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
