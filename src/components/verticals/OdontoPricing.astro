---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<section id="precios" class="scroll-mt-24 py-20 bg-slate-50 border-t border-slate-200/80">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-sky-500/10 border border-sky-500/20 px-3.5 py-1 text-xs font-bold text-sky-700">
        <span>🏷️ Planes para Salud Odontológica</span>
      </div>
      <h2 class="mt-4 font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0b1f4d] leading-tight">
        Invierte en la tranquilidad de tu clínica dental
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Yamassi es gratis para empezar. Configuración clínica y acompañamiento personalizado en Perú, sin contratos forzosos.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      <!-- PLAN 1: Odontólogo Solo -->
      <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-md flex flex-col justify-between transition-all hover:shadow-xl">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider font-bold text-slate-500">Consultorio Solo</span>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">1 Sillón Dental</span>
          </div>
          <h3 class="mt-3 text-2xl font-bold text-[#0b1f4d]">Plan Odontólogo Independiente</h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-500">Para doctores que atienden su propio consultorio o box dental privado.</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-xs text-slate-500 font-semibold">S/</span>
            <span class="text-4xl font-extrabold text-[#0b1f4d]">79</span>
            <span class="text-xs text-slate-500 font-medium">/ mes</span>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-6 space-y-3 text-xs sm:text-sm text-slate-700">
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Odontograma digital ilimitado (Adultos y Niños)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Historias clínicas y consentimientos informados</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Agenda con recordatorios por WhatsApp</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Presupuestos dentales exportables a PDF</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Boletas y facturas electrónicas de salud SUNAT</span>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <a
            href="/login"
            class="w-full inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white py-3 px-4 text-sm font-bold text-slate-800 transition-colors hover:bg-slate-50"
          >
            Empezar gratis
          </a>
        </div>
      </div>

      <!-- PLAN 2: Clínica Dental (DESTACADO) -->
      <div class="relative rounded-3xl border-2 border-sky-500 bg-white p-7 shadow-2xl flex flex-col justify-between md:scale-100 lg:scale-105 z-10">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-sky-500 via-blue-600 to-emerald-500 px-4 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-md">
          El Más Elegido por Clínicas
        </div>

        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider font-bold text-sky-600">Clínica Dental Pro</span>
            <span class="rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-bold text-sky-800">Hasta 4 Sillones</span>
          </div>
          <h3 class="mt-3 text-2xl font-bold text-[#0b1f4d]">Plan Centro Odontológico</h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-500">Para clínicas con recepcionista, múltiples doctores especialistas y alto flujo de pacientes.</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-xs text-slate-500 font-semibold">S/</span>
            <span class="text-4xl font-extrabold text-[#0b1f4d]">149</span>
            <span class="text-xs text-slate-500 font-medium">/ mes</span>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-6 space-y-3 text-xs sm:text-sm text-slate-700">
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Doctores y especialistas ilimitados</strong></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Agenda para hasta 4 sillones</strong> con WhatsApp</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Módulo de <strong>liquidación de comisiones</strong> médicas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Control de pagos a laboratorios dentales</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Caja clínica con control de saldos y cuotas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Almacenamiento de radiografías y fotos en nube</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Soporte prioritario personalizado los 7 días</span>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <a
            href="/login"
            class="w-full inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-sky-500 via-blue-600 to-emerald-500 py-3.5 px-4 text-sm font-bold text-white shadow-lg transition-transform hover:scale-102"
          >
            Empezar gratis
          </a>
        </div>
      </div>

      <!-- PLAN 3: Cadenas y Multisede -->
      <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-md flex flex-col justify-between transition-all hover:shadow-xl md:col-span-2 md:max-w-md md:mx-auto lg:col-span-1 lg:max-w-none w-full">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider font-bold text-slate-500">Cadenas Dentales</span>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">2+ Sedes</span>
          </div>
          <h3 class="mt-3 text-2xl font-bold text-[#0b1f4d]">Plan Corporativo Multisede</h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-500">Para policlínicos dentales y redes de consultorios con gestión médica y financiera unificada.</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-xs text-slate-500 font-semibold">S/</span>
            <span class="text-4xl font-extrabold text-[#0b1f4d]">299</span>
            <span class="text-xs text-slate-500 font-medium">/ mes por sede</span>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-6 space-y-3 text-xs sm:text-sm text-slate-700">
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Todo lo del Plan Centro Odontológico</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Historia clínica compartida entre todas las sedes</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Central telefónica y Call Center de citas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Dashboard gerencial con KPIs de rentabilidad médica</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Capacitación a secretarias y asistentes dentales</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>SLA de atención técnica garantizada 99.9%</span>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <a
            href="https://wa.me/51999999999?text=Hola%20Yamassi,%20quiero%20cotizar%20el%20Plan%20Corporativo%20Dental"
            class="w-full inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white py-3 px-4 text-sm font-bold text-slate-800 transition-colors hover:bg-slate-50"
          >
            Hablar con un consultor
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
