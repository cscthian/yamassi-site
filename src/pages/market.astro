---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { SiteHeader } from "@/components/ui/site-header";
import TiendaLanding, { TIENDA_FAQ, TIENDA_PLANS } from "@/components/verticals/TiendaLanding";
import { SiteFooter } from "@/components/blocks/site-footer";
import { SITE_URL } from "@/lib/site";
import { SUB_BRANDS } from "@/components/ui/sub-brand-logo";

const TIENDA_URL = SUB_BRANDS.market.app;

const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;

const title = "Yamassi Tienda — Sistema de caja, ventas e inventario para minimarkets, bodegas y tiendas en Perú";
const description =
  "Software de punto de venta (POS) e inventario para bodegas, minimarkets y tiendas en Perú: escáner de código de barras, balanza, control de vencimientos, kardex valorizado, proveedores y facturación SUNAT. Desde S/ 9.90 al mes.";

const offers = TIENDA_PLANS.map((plan) => ({
  "@type": "Offer",
  name: plan.name,
  price: plan.price.toFixed(2),
  priceCurrency: "PEN",
  url: pageUrl + "#precios",
  availability: "https://schema.org/InStock",
  description: [plan.capacity, plan.billing].filter(Boolean).join(". "),
  priceSpecification: {
    "@type": "UnitPriceSpecification",
    price: plan.price.toFixed(2),
    priceCurrency: "PEN",
    unitText: "mes",
  },
}));

const schema = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "es-PE",
    isPartOf: { "@id": `${SITE_URL}/#organization` },
    about: { "@id": `${pageUrl}#software` },
    primaryImageOfPage: `${SITE_URL}/img/yamassi-tienda-og.jpg`,
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#software`,
    name: "Yamassi Tienda",
    alternateName: ["Yamassi Market", "Yamassi Tiendas", "Yamassi POS Retail"],
    url: pageUrl,
    installUrl: TIENDA_URL,
    image: `${SITE_URL}/img/yamassi-tienda-og.jpg`,
    applicationCategory: "BusinessApplication",
    applicationSubCategory: "Punto de venta e inventario para bodegas, minimarkets y tiendas",
    operatingSystem: "Web (navegador en PC, laptop, tablet o celular)",
    inLanguage: "es-PE",
    areaServed: { "@type": "Country", name: "Perú" },
    publisher: { "@id": `${SITE_URL}/#organization` },
    description:
      "Yamassi Tienda es un software peruano en la nube para bodegas, minimarkets y tiendas: punto de venta con lector de código de barras y balanza, inventario y kardex valorizado, semáforo de vencimientos por lote, gestión de proveedores con importación de XML, control de fiados y facturación electrónica SUNAT.",
    featureList: [
      "Punto de venta con lector de código de barras y balanza electrónica",
      "Control de fiados con límite de crédito",
      "Inventario en tiempo real y kardex valorizado",
      "Alertas de stock mínimo",
      "Semáforo de vencimientos con avisos a 30, 15 y 7 días",
      "Gestión de proveedores e importación de facturas XML",
      "Boletas y facturas electrónicas SUNAT",
      "Ventas y productos ilimitados, hasta 10 colaboradores",
    ],
    offers,
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: TIENDA_FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Yamassi", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Yamassi Tienda", item: pageUrl },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  ogTitle="Yamassi Tienda — Caja, ventas e inventario que protegen cada sol"
  ogDescription="Escáner, balanza, vencimientos, kardex y facturación SUNAT para tu bodega o minimarket. Desde S/ 9.90 al mes, ventas y productos ilimitados."
  keywords="sistema para minimarket Perú, sistema para bodegas, software punto de venta, POS tienda, control de inventario, kardex valorizado, control de vencimientos, lector de código de barras, sistema de caja, facturación electrónica SUNAT, Yamassi Tienda"
  ogImage="/img/yamassi-tienda-og.jpg"
  ogImageAlt="Yamassi Tienda: cajera de bodega entregando la compra a un cliente"
  schema={schema}
  preloadVideo={false}
  preloadImage="/img/yamassi-tienda-hero.webp"
  themeColor="#0F172A"
>
  <main id="inicio" class="relative min-h-screen overflow-x-clip bg-white">
    {/* Navegación original de Yamassi con opciones de Market */}
    <SiteHeader client:load vertical="market" />

    {/* Landing Yamassi Tienda */}
    <TiendaLanding client:load />

    {/* Footer institucional */}
    <SiteFooter variant="tienda" />
  </main>
</Layout>
