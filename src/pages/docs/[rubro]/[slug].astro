---
export const prerender = true;

import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SiteHeader } from "@/components/ui/site-header";
import { SiteFooter } from "@/components/blocks/site-footer";
import { DOC_RUBROS, type DocRubro } from "@/lib/docs";
import { SITE_URL } from "@/lib/site";
import {
  ChevronRight,
  BookOpen,
  ArrowLeft,
  Sparkles,
  FileText,
  Clock,
  Layers,
} from "lucide-react";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => {
    // doc.id might be "pos/introduccion-yamassi-tiendas.md" or "pos/introduccion-yamassi-tiendas"
    const cleanId = doc.id.replace(/\.md$/, "");
    const parts = cleanId.split("/");
    const rubro = (parts.length > 1 ? parts[0] : doc.data.rubro) as DocRubro;
    const slug = parts[parts.length - 1];

    return {
      params: { rubro, slug },
      props: { doc, rubro },
    };
  });
}

const { doc, rubro: currentRubroKey } = Astro.props;
const { Content } = await render(doc);

const rubroMeta = DOC_RUBROS[currentRubroKey] || DOC_RUBROS.pos;
const Icon = rubroMeta.icon;

// Social card: each rubro shares its own vertical's image; reservas falls back to the brand card.
const RUBRO_OG: Partial<Record<string, { src: string; alt: string }>> = {
  pos: { src: "/img/yamassi-tienda-og.jpg", alt: "Yamassi Tienda: cajera de bodega entregando la compra a un cliente" },
  restobar: { src: "/img/yamassi-restobar-og.jpg", alt: "Yamassi Restobar: moza sirviendo platos peruanos a una mesa en un restaurante" },
  odontologia: { src: "/img/odonto-yamassi-og.jpg", alt: "Odonto Yamassi: odontóloga atendiendo a un paciente en un consultorio dental" },
};
const rubroOg = RUBRO_OG[currentRubroKey];

const allDocs = await getCollection("docs");
const siblingDocs = allDocs
  .filter((d) => d.data.rubro === currentRubroKey)
  .sort((a, b) => a.data.order - b.data.order);

const cleanDocSlug = doc.id.replace(/^.*\//, "").replace(/\.md$/, "");
const docUrl = `${SITE_URL}/docs/${currentRubroKey}/${cleanDocSlug}`;

// Schema.org TechArticle
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: doc.data.title,
  description: doc.data.description,
  author: {
    "@type": "Organization",
    name: "Yamassi",
    url: SITE_URL,
  },
  publisher: {
    "@type": "Organization",
    name: "Yamassi",
    url: SITE_URL,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": docUrl,
  },
  inLanguage: "es-PE",
};
---

<Layout
  title={`${doc.data.title} — Documentación Yamassi ${rubroMeta.shortName}`}
  description={doc.data.description}
  ogImage={rubroOg?.src}
  ogImageAlt={rubroOg?.alt}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main class="min-h-screen bg-slate-50 text-slate-900 overflow-x-clip">
    <SiteHeader client:load />

    <!-- Header del artículo de documentación -->
    <header class="relative pt-24 pb-14 sm:pt-32 sm:pb-16 bg-gradient-to-b from-[#0b1f4d] via-[#112264] to-[#080c14] text-white overflow-hidden">
      <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-96 w-[600px] rounded-full bg-emerald-500/20 blur-[130px]" aria-hidden="true"></div>

      <div class="container relative mx-auto px-4 max-w-5xl">
        <!-- Migas de pan -->
        <nav aria-label="Migas de pan" class="flex items-center gap-2 text-xs text-white/60 mb-6 flex-wrap">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <ChevronRight class="w-3 h-3 text-white/40" />
          <a href="/docs" class="hover:text-white transition-colors">Docs</a>
          <ChevronRight class="w-3 h-3 text-white/40" />
          <span class="text-white/80 font-medium">{rubroMeta.name}</span>
          <ChevronRight class="w-3 h-3 text-white/40" />
          <span class="text-emerald-300 truncate max-w-[200px] sm:max-w-none">{doc.data.title}</span>
        </nav>

        <!-- Badge de Rubro y Sección -->
        <div class="flex items-center gap-3 text-xs">
          <span class={`rounded-full border px-3.5 py-1 font-bold ${rubroMeta.bgLight}`}>
            {rubroMeta.name}
          </span>
          <span class="text-white/70 flex items-center gap-1.5 font-medium">
            <Layers class="w-3.5 h-3.5 text-emerald-400" />
            {doc.data.section}
          </span>
        </div>

        <!-- Título -->
        <h1 class="mt-5 font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight text-balance">
          {doc.data.title}
        </h1>

        <!-- Descripción -->
        <p class="mt-4 text-base sm:text-lg text-white/80 leading-relaxed max-w-3xl text-balance">
          {doc.data.description}
        </p>
      </div>
    </header>

    <!-- Contenido y Barra Lateral de Documentación -->
    <div class="py-10 sm:py-16">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-10 items-start">
          
          <!-- Sidebar: Navegación de Documentación -->
          <aside class="order-2 lg:order-1 rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sticky top-24">
            <div class="flex items-center gap-2.5 pb-4 border-b border-slate-100">
              <span class={`flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br ${rubroMeta.accentGradient} text-white shadow-xs`}>
                <Icon class="h-4 w-4" />
              </span>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Rubro</p>
                <h3 class="font-bold text-sm text-[#0b1f4d]">{rubroMeta.shortName}</h3>
              </div>
            </div>

            <!-- Listado de temas del rubro -->
            <div class="mt-5 space-y-1">
              <p class="px-2 pb-1.5 text-xs font-bold uppercase tracking-wider text-slate-400">
                Temas del Manual
              </p>
              {siblingDocs.map((item) => {
                const itemSlug = item.id.replace(/^.*\//, "").replace(/\.md$/, "");
                const isActive = itemSlug === cleanDocSlug;
                return (
                  <a
                    href={`/docs/${currentRubroKey}/${itemSlug}`}
                    class={`flex items-center justify-between gap-2 rounded-xl px-3 py-2 text-xs sm:text-sm font-semibold transition-all ${
                      isActive
                        ? "bg-[#0b1f4d] text-white shadow-sm"
                        : "text-slate-600 hover:bg-slate-100 hover:text-[#0b1f4d]"
                    }`}
                  >
                    <span class="truncate">{item.data.title}</span>
                    {isActive && <ChevronRight class="w-3.5 h-3.5 text-emerald-300 shrink-0" />}
                  </a>
                );
              })}
            </div>

            <!-- Otros rubros -->
            <div class="mt-6 pt-5 border-t border-slate-100 space-y-2">
              <p class="px-2 text-xs font-bold uppercase tracking-wider text-slate-400">
                Otros Rubros
              </p>
              <div class="space-y-1">
                {(["pos", "restobar", "reservas", "odontologia"] as DocRubro[])
                  .filter((k) => k !== currentRubroKey)
                  .map((k) => {
                    const r = DOC_RUBROS[k];
                    return (
                      <a
                        href={`/docs/${k}/${allDocs.find((d) => d.data.rubro === k)?.id.replace(/^.*\//, "").replace(/\.md$/, "") || ""}`}
                        class="flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-xs text-slate-600 hover:text-emerald-700 hover:bg-slate-50 transition-colors"
                      >
                        <span class={`h-2 w-2 rounded-full ${r.color.replace("text-", "bg-")}`}></span>
                        <span>{r.name}</span>
                      </a>
                    );
                  })}
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-slate-100">
              <a
                href="/docs"
                class="flex items-center gap-2 text-xs font-bold text-slate-500 hover:text-emerald-700 transition-colors"
              >
                <ArrowLeft class="w-3.5 h-3.5" />
                <span>Ver todos los rubros</span>
              </a>
            </div>
          </aside>

          <!-- Artículo Principal -->
          <article class="order-1 lg:order-2 overflow-x-clip">
            <div class="prose-formal bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-12 shadow-sm overflow-hidden">
              <Content />
            </div>

            <!-- Navegación y llamada a probar -->
            <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
              <a
                href="/docs"
                class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 hover:text-emerald-600 transition-colors"
              >
                <ArrowLeft class="w-4 h-4" />
                <span>Volver al índice de documentación</span>
              </a>

              <a
                href="/login"
                class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-md hover:scale-105 transition-all"
              >
                <Sparkles class="w-3.5 h-3.5" />
                <span>Probar {rubroMeta.shortName} gratis</span>
              </a>
            </div>
          </article>

        </div>
      </div>
    </div>

    <SiteFooter />
  </main>
</Layout>
