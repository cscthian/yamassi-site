---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SiteHeader } from "@/components/ui/site-header";
import { SiteFooter } from "@/components/blocks/site-footer";
import { DOC_RUBROS, type DocRubro } from "@/lib/docs";
import { BookOpen, Sparkles, ChevronRight, FileText } from "lucide-react";

const allDocs = await getCollection("docs");
const rubroKeys: DocRubro[] = ["pos", "restobar", "reservas", "odontologia"];
---

<Layout
  title="Documentación Oficial de Yamassi — Guías de Uso y Manuales"
  description="Aprende a configurar y utilizar los sistemas Yamassi: Punto de venta (POS Tiendas), Restobar (mesas y comandas), Reservas (servicios y turnos) y Odontología."
>
  <main class="min-h-screen bg-slate-50 text-slate-900">
    <SiteHeader client:load />

    <!-- Hero de Documentación -->
    <header class="relative pt-32 pb-20 overflow-hidden bg-gradient-to-b from-[#0b1f4d] via-[#112264] to-[#080c14] text-white">
      <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-96 w-[600px] rounded-full bg-emerald-500/20 blur-[130px]" aria-hidden="true"></div>

      <div class="container relative mx-auto px-4 text-center max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-4 py-1.5 text-xs font-bold text-emerald-300">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Centro de Documentación & Manuales</span>
        </div>

        <h1 class="mt-6 font-serif text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-balance leading-tight">
          Manuales y guías para dominar <span class="bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-300 bg-clip-text text-transparent">tu sistema Yamassi</span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-white/80 max-w-2xl mx-auto leading-relaxed text-balance">
          Encuentra tutoriales paso a paso, configuración de hardware (impresoras y lectores) y buenas prácticas de administración según tu rubro de negocio.
        </p>
      </div>
    </header>

    <!-- Secciones por Rubro -->
    <section class="py-16 sm:py-24">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {rubroKeys.map((rubroKey) => {
            const rubro = DOC_RUBROS[rubroKey];
            const Icon = rubro.icon;
            const rubroDocs = allDocs
              .filter((doc) => doc.data.rubro === rubroKey)
              .sort((a, b) => a.data.order - b.data.order);

            const firstDoc = rubroDocs[0];
            const targetUrl = firstDoc
              ? `/docs/${rubroKey}/${firstDoc.id.replace(/^.*\//, "").replace(/\.md$/, "")}`
              : `#`;

            return (
              <div class={`flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-7 sm:p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${rubro.borderAccent}`}>
                <div>
                  <div class="flex items-center justify-between gap-3">
                    <span class={`flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br ${rubro.accentGradient} text-white shadow-md`}>
                      <Icon class="h-6 w-6" />
                    </span>
                    <span class={`rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-wider ${rubro.bgLight}`}>
                      {rubro.badge}
                    </span>
                  </div>

                  <h2 class="mt-6 font-serif text-2xl font-bold text-[#0b1f4d]">
                    <a href={targetUrl} class="hover:text-emerald-700 transition-colors">
                      {rubro.name}
                    </a>
                  </h2>

                  <p class="mt-2.5 text-sm sm:text-base text-slate-600 leading-relaxed">
                    {rubro.description}
                  </p>

                  <!-- Listado de Artículos del Rubro -->
                  <div class="mt-6 pt-5 border-t border-slate-100 space-y-2">
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                      Artículos disponibles ({rubroDocs.length})
                    </p>
                    {rubroDocs.map((doc) => {
                      const docSlug = doc.id.replace(/^.*\//, "").replace(/\.md$/, "");
                      return (
                        <a
                          href={`/docs/${rubroKey}/${docSlug}`}
                          class="flex items-center justify-between gap-2 rounded-xl p-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-emerald-700 transition-colors group"
                        >
                          <div class="flex items-center gap-2.5 truncate">
                            <FileText class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 shrink-0" />
                            <span class="truncate">{doc.data.title}</span>
                          </div>
                          <ChevronRight class="w-4 h-4 text-slate-300 group-hover:text-emerald-600 shrink-0 transition-transform group-hover:translate-x-0.5" />
                        </a>
                      );
                    })}
                  </div>
                </div>

                <div class="mt-8 pt-4">
                  <a
                    href={targetUrl}
                    class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 py-3 text-sm font-bold text-slate-700 hover:bg-[#0b1f4d] hover:text-white hover:border-[#0b1f4d] transition-all"
                  >
                    <span>Ver documentación de {rubro.shortName}</span>
                    <ChevronRight class="w-4 h-4" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>
