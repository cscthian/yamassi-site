---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { YamassiLogo } from "@/components/ui/yamassi-logo";
import PlatformOrbitCarousel, { type Platform } from "@/components/ui/platform-orbit-carousel";
import { SUB_BRANDS } from "@/components/ui/sub-brand-logo";
import { getDomainFromUrl } from "@/lib/site";

// Production sign-in of each platform (fixed on purpose: never an empty or local URL).
const TIENDA_URL = SUB_BRANDS.market.app;
const RESTOBAR_URL = SUB_BRANDS.restaurantes.app;
const ODONTO_URL = SUB_BRANDS.odontologia.app;
import { ShieldCheck, Sparkles, ArrowLeft } from "lucide-react";

/** One slide per platform; colours and marks are each sub-brand's own. */
const PLATFORMS: Platform[] = [
  {
    title: "Yamassi",
    subtitle: "Tienda",
    image: "/yamassi-tienda.svg",
    alt: "Logo de Yamassi Tienda",
    eyebrow: "Minimarkets, bodegas y retail",
    label: "Yamassi Tienda",
    accent: "#10B981",
    accentInk: "#06281D",
    name: "Yamassi Tienda",
    description:
      "Punto de venta rápido con código de barras y balanza, control de stock y vencimientos, proveedores y facturación electrónica SUNAT.",
    features: ["Escáner y balanza", "Kardex valorizado", "Vencimientos", "Proveedores", "Boletas SUNAT"],
    url: TIENDA_URL,
    domain: getDomainFromUrl(TIENDA_URL),
    page: "/market/",
  },
  {
    title: "Yamassi",
    subtitle: "Restobar",
    image: "/yamassi-restobar.svg",
    alt: "Logo de Yamassi Restobar",
    eyebrow: "Restaurantes, cafeterías y bares",
    label: "Yamassi Restobar",
    accent: "#C1121F",
    accentInk: "#FFFFFF",
    name: "Yamassi Restobar",
    description:
      "Comandas en tiempo real a cocina y barra, mapa de mesas, caja con arqueo ciego, recetas y división de cuentas.",
    features: ["Comandas", "Cocina y barra (KDS)", "Mesas", "Arqueo ciego", "Recetas"],
    url: RESTOBAR_URL,
    domain: getDomainFromUrl(RESTOBAR_URL),
    page: "/restaurantes/",
  },
  {
    title: "Odonto",
    subtitle: "Yamassi",
    image: "/yamassi-odonto.svg",
    alt: "Logo de Odonto Yamassi",
    eyebrow: "Consultorios y clínicas dentales",
    label: "Odonto Yamassi",
    accent: "#FCD448",
    accentInk: "#021D4A",
    name: "Odonto Yamassi",
    description:
      "Odontograma digital, historias clínicas y consentimientos, agenda con recordatorios por WhatsApp y caja con arqueo.",
    features: ["Odontograma", "Historias clínicas", "Agenda", "Recordatorios WhatsApp", "Caja"],
    url: ODONTO_URL,
    domain: getDomainFromUrl(ODONTO_URL),
    page: "/odontologia/",
  },
];
---

<Layout
  title="Iniciar sesión — Elige tu plataforma Yamassi"
  description="Acceso directo a tu panel de Yamassi: Yamassi Tienda (minimarkets y bodegas), Yamassi Restobar (restaurantes) u Odonto Yamassi (consultorios dentales)."
  preloadVideo={false}
  noindex
  themeColor="#0b1f4d"
>
  <main class="relative min-h-screen bg-[#0b1f4d] text-white selection:bg-emerald-400 selection:text-slate-900">
    <!-- Barra superior sobre el carrusel -->
    <header class="fixed inset-x-0 top-0 z-30 bg-gradient-to-b from-[#060e24]/90 to-transparent">
      <div class="container mx-auto flex h-16 items-center justify-between gap-3 px-3 sm:px-6">
        <a href="/" aria-label="Yamassi inicio" class="flex items-center">
          <YamassiLogo inverted />
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          <a href="/" class="hidden items-center gap-1.5 text-sm font-medium text-white/75 transition-colors hover:text-white sm:inline-flex">
            <ArrowLeft class="h-4 w-4" />
            Volver al inicio
          </a>
          <a
            href="https://www.facebook.com/yamassioficial"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-1 rounded-full border border-emerald-400/40 bg-emerald-500/15 px-2.5 py-1 text-[11px] font-bold text-emerald-300 transition-all hover:bg-emerald-500/25 sm:gap-1.5 sm:px-3.5 sm:py-1.5 sm:text-xs"
          >
            <Sparkles class="h-3.5 w-3.5" />
            <span class="hidden sm:inline">¿No puedes ingresar?</span>
            <span class="underline underline-offset-2">Contacta</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Carrusel de plataformas -->
    <div
      style="--pof-bg:#0b1f4d;--pof-fg:#ffffff;--pof-muted:rgba(255,255,255,.62);--pof-primary:#34d399;background:linear-gradient(180deg,#060e24,#0b1f4d 45%,#0b1f4d)"
    >
      <PlatformOrbitCarousel client:load items={PLATFORMS} heading="Inicia sesión en tu sistema" backdrop="/img/login-fondo.webp" backdropSet="/img/login-fondo-800.webp 800w, /img/login-fondo.webp 1536w" />
    </div>

    <!-- Garantía de seguridad -->
    <div class="relative z-10 px-4 py-10 text-center text-xs text-white/55">
      <div class="flex flex-wrap items-center justify-center gap-4">
        <span class="flex items-center gap-1.5">
          <ShieldCheck class="h-4 w-4 text-emerald-400" />
          Conexión segura cifrada con TLS 1.3 / SSL 256 bits
        </span>
        <span class="hidden text-white/20 sm:inline">•</span>
        <span>Acceso exclusivo para comercios autorizados</span>
        <span class="hidden text-white/20 sm:inline">•</span>
        <a href="/info/politicas-privacidad" class="underline transition-colors hover:text-white">Políticas de privacidad y seguridad</a>
      </div>
    </div>

    <footer class="relative z-10 border-t border-white/10 py-6 text-center text-xs text-white/40">
      <div class="container mx-auto px-4">
        © {new Date().getFullYear()} Yamassi · Sistema de gestión comercial y facturación electrónica homologada ante SUNAT.
      </div>
    </footer>
  </main>
</Layout>
