---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { YamassiLogo } from "@/components/ui/yamassi-logo";
import { TIENDA_URL, RESTOBAR_URL, CITAS_URL, getDomainFromUrl } from "@/lib/site";
import {
  Store,
  UtensilsCrossed,
  CalendarCheck,
  ArrowRight,
  ArrowLeft,
  ShieldCheck,
  ExternalLink,
  Sparkles,
} from "lucide-react";

const LOGIN_OPTIONS = [
  {
    title: "Tienda (Market)",
    category: "Minimarkets, Bodegas y Retail",
    badge: "POS & Stock",
    description:
      "Punto de venta rápido con código de barras, control de stock, lotes, proveedores y facturación electrónica SUNAT.",
    url: TIENDA_URL,
    domain: getDomainFromUrl(TIENDA_URL),
    icon: Store,
    gradient: "from-emerald-500 to-teal-600",
    borderHover: "hover:border-emerald-400/80 hover:shadow-[0_20px_50px_rgba(16,185,129,0.25)]",
    badgeBg: "bg-emerald-500/15 text-emerald-300 border-emerald-500/30",
    buttonBg: "bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white",
  },
  {
    title: "Restobar (Restaurantes, cafe y Bares)",
    category: "Restaurantes, Cafeterías y Bares",
    badge: "Comandas & Mesas",
    description:
      "Comandas en tiempo real a cocina y barra, control de mesas, caja rápida, escandallos y división de cuentas.",
    url: RESTOBAR_URL,
    domain: getDomainFromUrl(RESTOBAR_URL),
    icon: UtensilsCrossed,
    gradient: "from-amber-400 to-orange-500",
    borderHover: "hover:border-amber-400/80 hover:shadow-[0_20px_50px_rgba(245,158,11,0.25)]",
    badgeBg: "bg-amber-500/15 text-amber-300 border-amber-500/30",
    buttonBg: "bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white",
  },
  {
    title: "Reservas y citas",
    category: "Clínicas, Consultorios y Servicios",
    badge: "Agenda & Citas",
    description:
      "Agenda médica y de citas, odontograma digital, recordatorios automáticos por WhatsApp e historias clínicas.",
    url: CITAS_URL,
    domain: getDomainFromUrl(CITAS_URL),
    icon: CalendarCheck,
    gradient: "from-sky-400 to-blue-600",
    borderHover: "hover:border-sky-400/80 hover:shadow-[0_20px_50px_rgba(14,165,233,0.25)]",
    badgeBg: "bg-sky-500/15 text-sky-300 border-sky-500/30",
    buttonBg: "bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white",
  },
];
---

<Layout
  title="Iniciar Sesión — Elige tu plataforma Yamassi"
  description="Acceso directo a tu panel de control de Yamassi: Tienda (Market), Restobar o Reservas y citas."
>
  <main class="relative min-h-screen flex flex-col justify-between overflow-hidden bg-gradient-to-b from-[#060e24] via-[#0b1f4d] to-[#040814] text-white selection:bg-emerald-400 selection:text-slate-900">
    <!-- Luces de fondo ambientales -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 h-[500px] w-[900px] rounded-full bg-blue-600/15 blur-[160px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-1/3 -left-40 h-[400px] w-[500px] rounded-full bg-emerald-500/10 blur-[150px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-0 right-0 h-[400px] w-[500px] rounded-full bg-indigo-500/15 blur-[150px]" aria-hidden="true"></div>

    <!-- Barra de navegación superior -->
    <header class="relative z-20 border-b border-white/10 bg-white/5 backdrop-blur-xl">
      <div class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-white/70 hover:text-white transition-colors group"
        >
          <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          <span>Volver al inicio</span>
        </a>

        <a href="/" aria-label="Yamassi inicio" class="flex items-center">
          <YamassiLogo inverted />
        </a>

        <a
          href="https://www.facebook.com/yamassioficial"
          target="_blank"
          class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/40 bg-emerald-500/15 px-3.5 py-1.5 text-xs font-bold text-emerald-300 hover:bg-emerald-500/25 transition-all"
        >
          <Sparkles class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">¿No puedes ingresar?</span>
          <span class="underline underline-offset-2">Contacta</span>
        </a>
      </div>
    </header>

    <!-- Contenido central elegante -->
    <div class="relative z-10 container mx-auto px-4 py-12 sm:py-20 flex-1 flex flex-col justify-center max-w-6xl">
      <!-- Encabezado central -->
      <div class="text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-1 text-xs font-semibold text-emerald-300 backdrop-blur-md shadow-inner">
          <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
          <span>Acceso Unificado a Plataformas Yamassi</span>
        </div>

        <h1 class="mt-5 font-serif text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Inicia sesión en tu sistema
        </h1>

        <p class="mt-4 text-base sm:text-lg text-white/75 leading-relaxed text-balance">
          Selecciona el software correspondiente a tu rubro para ingresar directamente a tu panel de administración.
        </p>
      </div>

      <!-- Tarjetas de selección al centro -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        {LOGIN_OPTIONS.map((opt, idx) => {
          const Icon = opt.icon;
          return (
            <a
              href={opt.url}
              class={`group relative flex flex-col justify-between rounded-3xl border border-white/15 bg-[#0b1f4d]/80 p-7 sm:p-8 backdrop-blur-2xl transition-all duration-300 hover:-translate-y-1.5 ${opt.borderHover} shadow-[0_10px_30px_rgba(0,0,0,0.35)] ${
                idx === 2 ? "md:col-span-2 md:max-w-md md:mx-auto lg:col-span-1 lg:max-w-none w-full" : ""
              }`}
            >
              <div>
                <!-- Encabezado de la tarjeta -->
                <div class="flex items-start justify-between gap-3">
                  <div class={`flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br ${opt.gradient} text-white shadow-lg transition-transform duration-300 group-hover:scale-110 group-hover:rotate-[-3deg]`}>
                    <Icon class="h-7 w-7" />
                  </div>

                  <span class={`rounded-full border px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider ${opt.badgeBg}`}>
                    {opt.badge}
                  </span>
                </div>

                <!-- Título y categoría -->
                <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-white/50">
                  {opt.category}
                </p>
                <h2 class="mt-1 text-2xl font-bold text-white group-hover:text-emerald-200 transition-colors">
                  {opt.title}
                </h2>

                <!-- Descripción -->
                <p class="mt-3 text-sm text-white/70 leading-relaxed">
                  {opt.description}
                </p>
              </div>

              <!-- Botón inferior con link directo -->
              <div class="mt-8 pt-5 border-t border-white/10">
                <div class="flex items-center justify-between text-xs text-white/50 font-mono mb-3">
                  <span>URL directa</span>
                  <span class="text-white/80 flex items-center gap-1 group-hover:text-emerald-300 transition-colors">
                    {opt.domain}
                    <ExternalLink class="w-3 h-3" />
                  </span>
                </div>

                <div
                  class={`w-full inline-flex items-center justify-center gap-2 rounded-2xl py-3.5 px-4 text-sm font-bold shadow-lg transition-all ${opt.buttonBg} group-hover:shadow-[0_8px_20px_rgba(0,0,0,0.4)]`}
                >
                  <span>Ingresar a mi cuenta</span>
                  <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Garantía de seguridad -->
      <div class="mt-12 text-center text-xs text-white/50 flex flex-wrap items-center justify-center gap-4">
        <span class="flex items-center gap-1.5">
          <ShieldCheck class="w-4 h-4 text-emerald-400" />
          Conexión segura cifrada con TLS 1.3 / SSL 256 bits
        </span>
        <span class="hidden sm:inline text-white/20">•</span>
        <span>Acceso exclusivo para comercios autorizados</span>
        <span class="hidden sm:inline text-white/20">•</span>
        <a href="/info/politicas-privacidad" class="underline hover:text-white transition-colors">
          Políticas de privacidad y seguridad
        </a>
      </div>
    </div>

    <!-- Pie de página mínimo -->
    <footer class="relative z-10 border-t border-white/10 py-6 text-center text-xs text-white/40">
      <div class="container mx-auto px-4">
        © {new Date().getFullYear()} Yamassi · Sistema de gestión comercial y facturación electrónica homologada ante SUNAT.
      </div>
    </footer>
  </main>
</Layout>
