# ==============================================================================
# YAMASSI — VARIABLES DE ENTORNO EN DESARROLLO (npm run dev)
# ==============================================================================
# Vite y Astro cargan automáticamente este archivo al ejecutar `npm run dev`.

# Identificador de entorno
PUBLIC_ENV=development

# URL del sitio web estático local (Astro dev server)
PUBLIC_SITE_URL=http://localhost:4321

# URLs locales para desarrollo de las aplicaciones del ecosistema Yamassi
PUBLIC_TIENDA_URL=http://localhost:3000/
PUBLIC_RESTOBAR_URL=http://localhost:3002/
PUBLIC_CITAS_URL=http://localhost:3003/
PUBLIC_API_URL=http://localhost:8000/api

# Configuración institucional para desarrollo
PUBLIC_SITE_NAME=Yamassi (Dev Local)
PUBLIC_SUPPORT_EMAIL=dev@yamassi.com
PUBLIC_WHATSAPP_NUMBER=+51999999999

# Debug y analíticas en desarrollo
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_DEBUG_LOGS=true
